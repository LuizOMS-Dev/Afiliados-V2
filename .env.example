# Copie para .env e preencha antes de iniciar. Nunca versione o .env.
PORT=3000
NODE_ENV=production
TZ=America/Sao_Paulo
# Compose monta DATABASE_URL automaticamente. No EasyPanel, informe a URL do banco.
DATABASE_URL=postgresql://afiliados:CHANGE_ME@db:5432/afiliados
POSTGRES_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=
# Endereço público HTTPS definitivo, sem barra final.
PUBLIC_BASE_URL=https://SEU-DOMINIO
MESSAGE_LINK_MODE=affiliate
UPLOAD_DIR=/data/products
WAHA_KEY_FILE=/data/secrets/waha.key
